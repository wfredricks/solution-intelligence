# Solution Intelligence — Runtime Pipeline
#
# Renders to docs/diagrams/pipeline.svg + pipeline.png
# Build:
#   d2 --layout=dagre --pad=20 pipeline.d2 pipeline.svg
#   d2 --layout=dagre --pad=20 pipeline.d2 pipeline.png
#
# Layout note: dagre produces ~4.4:1 aspect for this 7-element chain.
# ELK produces ~11.6:1. Dagre is the right choice for linear pipelines.
#
# Design notes (iteration 7):
#
#   * Earlier iterations used mixed shapes (hexagons, diamonds,
#     cylinders, clouds) to convey node types. This caused ELK
#     to over-space the diagram and produced ultrawide layouts.
#
#   * Iteration 7 uses uniform rectangles with corner icons.
#     The icon (top-left) carries the type signal; the rectangle
#     is just a content container. ELK packs these much tighter.
#
#   * Icons are from Terrastruct's bundled set (free, hotlinkable,
#     never expire per the icons.terrastruct.com guarantee). The
#     icon style happens to be AWS-branded; that's a happy match
#     since the pipeline can run on AWS substrates, but the icons
#     are decorative and can be swapped without changing the model.
#
#   * Identity (SI/I) and chainblocks audit are not shown as
#     connected nodes \u2014 their universal nature would force the
#     layout into ultrawide or super-tall. Both are described in
#     PIPELINE.md prose immediately below this diagram.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}

direction: right

# ── The seven pipeline elements ──────────────────────────────────────────

input_bucket: "Input Bucket\nS3 (customer data)" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
  icon.near: top-left
  style: {
    fill: "#E3F2FD"
    stroke: "#1976D2"
    stroke-width: 2
    bold: true
  }
}

parsers: "Parsers\nTree-sitter / ANTLR / PDF" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
  icon.near: top-left
  style: {
    fill: "#F3E5F5"
    stroke: "#6A1B9A"
    stroke-width: 2
    bold: true
  }
}

dsl: ".sigdsl stream\ntyped JSONL" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FAnalytics%2FAmazon-Kinesis-Data-Streams.svg
  icon.near: top-left
  style: {
    fill: "#FFFDE7"
    stroke: "#F57F17"
    stroke-width: 2
    stroke-dash: 3
  }
}

graphloader: "GraphLoader\nsole writer to SI/G" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
  icon.near: top-left
  style: {
    fill: "#F3E5F5"
    stroke: "#6A1B9A"
    stroke-width: 2
    bold: true
  }
}

graph: "SI/G\nKnowledge Graph" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-Neptune.svg
  icon.near: top-left
  style: {
    fill: "#9C27B0"
    stroke: "#4A148C"
    stroke-width: 2
    font-color: "#FFFFFF"
    bold: true
  }
}

graphreader: "GraphReader\nsole producer of\ndeliverables" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
  icon.near: top-left
  style: {
    fill: "#F3E5F5"
    stroke: "#6A1B9A"
    stroke-width: 2
    bold: true
  }
}

output_bucket: "Output Bucket\nS3 git-tree" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
  icon.near: top-left
  style: {
    fill: "#E8F5E9"
    stroke: "#388E3C"
    stroke-width: 2
    bold: true
  }
}

window: "SI/W Window\nconsumer UI" {
  shape: rectangle
  icon: https://icons.terrastruct.com/aws%2FMobile%2FAWS-Amplify.svg
  icon.near: top-left
  style: {
    fill: "#E1F5FE"
    stroke: "#0277BD"
    stroke-width: 2
    bold: true
  }
}

# ── Edges (the pipeline) ─────────────────────────────────────────────────

input_bucket -> parsers
parsers -> dsl: "emit"
dsl -> graphloader: "land + validate"
graphloader -> graph: "promotes" {
  style.stroke-width: 3
  style.stroke: "#4A148C"
}
graph -> graphreader: "read"
graphreader -> output_bucket: "writes" {
  style.stroke-width: 3
  style.stroke: "#388E3C"
}
output_bucket -> window: "reads"
